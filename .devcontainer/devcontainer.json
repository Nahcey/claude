{
  "name": "Claude Java 17",
  "image": "mcr.microsoft.com/devcontainers/java:1-17-bookworm",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Spring Boot (spring-board)",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-boot-dev-pack",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-17",
            "path": "/usr/local/sdkman/candidates/java/current",
            "default": true
          }
        ]
      }
    }
  },

  "postCreateCommand": "chmod +x java/gradlew spring-board/gradlew && java -version"
}
